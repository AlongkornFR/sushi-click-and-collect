# Copier ce fichier en .env et remplir les valeurs.

# OBLIGATOIRE en production (DEBUG=False) — le serveur refuse de démarrer sinon.
# Générer : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True en dev local uniquement
DEBUG=True

# URLs publiques
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://127.0.0.1:8000

# Base de données (vide = SQLite local)
DATABASE_URL=

# Paiement Payplug
PAYPLUG_SECRET_KEY=
PAYPLUG_API_VERSION=2019-08-06

# Cloudflare Images
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_TOKEN=

# Emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_RECEIVER_EMAIL=

# Origines CORS supplémentaires, séparées par des virgules (optionnel)
CORS_EXTRA_ORIGINS=
